+static bool configured_has_extension(const cbm_module_resolution_config_t *config,
+                                     const char *module_path) {
+    size_t path_len = strlen(module_path);
+    for (int i = 0; i < config->extension_count; i++) {
+        size_t ext_len = strlen(config->extensions[i]);
+        if (path_len >= ext_len &&
+            module_path_equal(module_path + path_len - ext_len, config->extensions[i],
+                              config->case_insensitive)) {
+            return true;
+        }
+    }
+    return false;
+}
