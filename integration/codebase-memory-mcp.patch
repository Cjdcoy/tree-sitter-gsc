+static bool module_path_char_equal(char a, char b, bool case_insensitive) {
+    if (!case_insensitive) {
+        return a == b;
+    }
+    return tolower((unsigned char)a) == tolower((unsigned char)b);
+}
+
+static bool module_path_equal(const char *a, const char *b, bool case_insensitive) {
+    if (!a || !b) {
+        return false;
+    }
+    while (*a && *b) {
+        if (!module_path_char_equal(*a, *b, case_insensitive)) {
+            return false;
+        }
+        a++;
+        b++;
+    }
+    return *a == '\0' && *b == '\0';
+}
+
+static bool module_path_prefix(const char *path, const char *prefix, bool case_insensitive) {
+    if (!path || !prefix) {
+        return false;
+    }
+    size_t prefix_len = strlen(prefix);
+    if (prefix_len == 0) {
+        return true;
+    }
+    for (size_t i = 0; i < prefix_len; i++) {
+        if (!path[i] || !module_path_char_equal(path[i], prefix[i], case_insensitive)) {
+            return false;
+        }
+    }
+    return path[prefix_len] == '\0' || path[prefix_len] == '/';
+}
+
+static bool configured_source_root(const cbm_module_resolution_config_t *config,
+                                   const char *source_rel) {
+    char normalized[PKGMAP_PATH_BUF];
+    if (!normalize_module_path(source_rel, normalized, sizeof(normalized))) {
+        return false;
+    }
+    for (int i = 0; i < config->source_root_count; i++) {
+        if (module_path_prefix(normalized, config->source_roots[i], config->case_insensitive)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool rewrite_configured_alias(const cbm_module_resolution_config_t *config,
+                                     const char *module_path, char *out, size_t out_size) {
+    const cbm_module_alias_t *best = NULL;
+    size_t best_len = 0;
+    for (int i = 0; i < config->alias_count; i++) {
+        size_t len = strlen(config->aliases[i].from);
+        if (len > best_len &&
+            module_path_prefix(module_path, config->aliases[i].from, config->case_insensitive)) {
+            best = &config->aliases[i];
+            best_len = len;
+        }
+    }
+    if (!best) {
+        int n = snprintf(out, out_size, "%s", module_path);
+        return n >= 0 && (size_t)n < out_size;
+    }
+    const char *suffix = module_path + best_len;
+    while (*suffix == '/') {
+        suffix++;
+    }
+    int n = suffix[0] && best->to[0]
+                ? snprintf(out, out_size, "%s/%s", best->to, suffix)
+                : snprintf(out, out_size, "%s", suffix[0] ? suffix : best->to);
+    return n >= 0 && (size_t)n < out_size;
+}
