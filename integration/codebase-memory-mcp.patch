+const cbm_gbuf_node_t *cbm_pipeline_resolve_configured_module(
+    const cbm_pipeline_ctx_t *ctx, const char *source_rel, const char *source_file_qn,
+    const char *module_path, bool *handled) {
+    *handled = false;
+    const cbm_module_resolution_config_t *config = ctx->module_resolution;
+    if (!config || !configured_source_root(config, source_rel)) {
+        return NULL;
+    }
+    *handled = true;
+
+    char normalized[PKGMAP_PATH_BUF];
+    char runtime_path[PKGMAP_PATH_BUF];
+    if (!normalize_module_path(module_path, normalized, sizeof(normalized)) || !normalized[0] ||
+        !rewrite_configured_alias(config, normalized, runtime_path, sizeof(runtime_path))) {
+        return NULL;
+    }
+
+    bool already_has_extension = configured_has_extension(config, runtime_path);
+    for (int root_index = 0; root_index < config->source_root_count; root_index++) {
+        const char *root = config->source_roots[root_index];
+        char base[PKGMAP_PATH_BUF];
+        int bn = root[0] ? snprintf(base, sizeof(base), "%s/%s", root, runtime_path)
+                         : snprintf(base, sizeof(base), "%s", runtime_path);
+        if (bn < 0 || (size_t)bn >= sizeof(base)) {
