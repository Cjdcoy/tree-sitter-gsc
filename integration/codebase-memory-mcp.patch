+static char *module_config_path_dup(const char *value) {
+    char normalized[PKGMAP_PATH_BUF];
+    if (!normalize_module_path(value, normalized, sizeof(normalized))) {
+        return NULL;
+    }
+    return strdup(normalized);
+}
+
+static int module_config_append(char ***items, int *count, char *value) {
+    char **grown = realloc(*items, (size_t)(*count + 1) * sizeof(char *));
+    if (!grown) {
+        return CBM_NOT_FOUND;
+    }
+    grown[*count] = value;
+    *items = grown;
+    (*count)++;
+    return 0;
+}
