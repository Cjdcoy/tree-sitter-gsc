+cbm_module_resolution_config_t *cbm_module_resolution_config_load(const char *repo_path) {
+    if (!repo_path || !repo_path[0]) {
+        return NULL;
+    }
+    char path[PKGMAP_PATH_BUF];
+    int pn = snprintf(path, sizeof(path), "%s/.codebase-memory.json", repo_path);
+    if (pn <= 0 || (size_t)pn >= sizeof(path)) {
+        return NULL;
+    }
+    int source_len = 0;
+    char *source = pkgmap_read_file(path, &source_len);
+    if (!source) {
+        return NULL;
+    }
+    yyjson_doc *doc = yyjson_read(source, (size_t)source_len, 0);
+    free(source);
+    if (!doc) {
+        return NULL; /* userconfig loader owns corrupt-JSON diagnostics */
+    }
+    yyjson_val *root = yyjson_doc_get_root(doc);
+    yyjson_val *section = yyjson_is_obj(root) ? yyjson_obj_get(root, "module_resolution") : NULL;
+    if (!yyjson_is_obj(section)) {
+        yyjson_doc_free(doc);
+        return NULL;
+    }
+
+    cbm_module_resolution_config_t *config = calloc(1, sizeof(*config));
+    if (!config) {
+        yyjson_doc_free(doc);
+        return NULL;
+    }
+
+    yyjson_val *roots = yyjson_obj_get(section, "source_roots");
+    if (yyjson_is_arr(roots)) {
+        size_t idx, max;
+        yyjson_val *value;
+        yyjson_arr_foreach(roots, idx, max, value) {
+            const char *raw = yyjson_get_str(value);
+            char *normalized = raw ? module_config_path_dup(raw) : NULL;
+            if (!normalized ||
+                module_config_append(&config->source_roots, &config->source_root_count,
+                                     normalized) != 0) {
+                free(normalized);
+                cbm_module_resolution_config_free(config);
+                yyjson_doc_free(doc);
+                return NULL;
+            }
+        }
+    }
+
+    yyjson_val *aliases = yyjson_obj_get(section, "aliases");
+    if (yyjson_is_obj(aliases)) {
+        yyjson_obj_iter iter;
+        yyjson_obj_iter_init(aliases, &iter);
+        yyjson_val *key;
+        while ((key = yyjson_obj_iter_next(&iter)) != NULL) {
+            const char *from_raw = yyjson_get_str(key);
+            const char *to_raw = yyjson_get_str(yyjson_obj_iter_get_val(key));
+            char *from = from_raw ? module_config_path_dup(from_raw) : NULL;
+            char *to = to_raw ? module_config_path_dup(to_raw) : NULL;
+            if (!from || !from[0] || !to) {
+                free(from);
+                free(to);
+                continue;
+            }
+            cbm_module_alias_t *grown =
+                realloc(config->aliases, (size_t)(config->alias_count + 1) * sizeof(*grown));
+            if (!grown) {
+                free(from);
+                free(to);
+                cbm_module_resolution_config_free(config);
+                yyjson_doc_free(doc);
+                return NULL;
+            }
+            config->aliases = grown;
+            config->aliases[config->alias_count++] = (cbm_module_alias_t){.from = from, .to = to};
+        }
+    }
+
+    yyjson_val *extensions = yyjson_obj_get(section, "extensions");
+    if (yyjson_is_arr(extensions)) {
+        size_t idx, max;
+        yyjson_val *value;
+        yyjson_arr_foreach(extensions, idx, max, value) {
+            const char *raw = yyjson_get_str(value);
+            if (!raw || raw[0] != '.' || strchr(raw, '/') || strchr(raw, '\\')) {
+                continue;
+            }
+            char *copy = strdup(raw);
+            if (!copy || module_config_append(&config->extensions, &config->extension_count, copy) !=
+                             0) {
+                free(copy);
+                cbm_module_resolution_config_free(config);
+                yyjson_doc_free(doc);
+                return NULL;
+            }
+        }
+    }
+
+    yyjson_val *case_insensitive = yyjson_obj_get(section, "case_insensitive");
+    config->case_insensitive = yyjson_is_bool(case_insensitive) && yyjson_get_bool(case_insensitive);
+    yyjson_doc_free(doc);
+
+    if (config->source_root_count == 0) {
+        cbm_module_resolution_config_free(config);
+        return NULL;
+    }
+    return config;
+}
