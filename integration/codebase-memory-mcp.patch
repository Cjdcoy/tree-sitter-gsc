+static const cbm_gbuf_node_t *find_configured_target(const cbm_pipeline_ctx_t *ctx,
+                                                     const char *candidate,
+                                                     const char *source_file_qn,
+                                                     bool case_insensitive) {
+    configured_target_search_t search = {
+        .candidate = candidate,
+        .source_file_qn = source_file_qn,
+        .case_insensitive = case_insensitive,
+    };
+    cbm_gbuf_foreach_node(ctx->gbuf, configured_target_visitor, &search);
+    return search.module ? search.module : search.file;
