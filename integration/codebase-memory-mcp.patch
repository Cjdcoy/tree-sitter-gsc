+void cbm_module_resolution_config_free(cbm_module_resolution_config_t *config) {
+    if (!config) {
+        return;
+    }
+    for (int i = 0; i < config->source_root_count; i++) {
+        free(config->source_roots[i]);
+    }
+    free(config->source_roots);
+    for (int i = 0; i < config->alias_count; i++) {
+        free(config->aliases[i].from);
+        free(config->aliases[i].to);
+    }
+    free(config->aliases);
+    for (int i = 0; i < config->extension_count; i++) {
+        free(config->extensions[i]);
+    }
+    free(config->extensions);
+    free(config);
+}
