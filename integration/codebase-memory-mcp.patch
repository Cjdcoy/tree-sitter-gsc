+                                          const char **import_map_vals, int import_map_count) {
+    if (!r || !callee_name || !callee_name[0]) {
+        return empty_result();
+    }
+
+    if (qualified_module_qn && qualified_module_qn[0]) {
+        cbm_resolution_t res =
+            resolve_same_module(r, callee_name, NULL, qualified_module_qn);
+        if (res.qualified_name && res.qualified_name[0]) {
+            res.strategy = "gsc_module_path";
+            res.confidence = CONF_IMPORT_MAP;
+        }
+        return res;
+    }
+
+    if (module_qn && module_qn[0]) {
+        cbm_resolution_t local = resolve_same_module(r, callee_name, NULL, module_qn);
+        if (local.qualified_name && local.qualified_name[0]) {
+            local.strategy = "gsc_local";
+            return local;
+        }
+    }
+
+    const char *included_qn = NULL;
+    int included_count = 0;
+    for (int i = 0; import_map_vals && i < import_map_count; i++) {
+        if (!import_map_vals[i] || !import_map_vals[i][0]) {
+            continue;
+        }
+        cbm_resolution_t included =
+            resolve_same_module(r, callee_name, NULL, import_map_vals[i]);
+        if (!included.qualified_name || !included.qualified_name[0] ||
+            (included_qn && strcmp(included_qn, included.qualified_name) == 0)) {
+            continue;
+        }
+        included_qn = included.qualified_name;
+        included_count++;
+    }
+    if (included_count == SKIP_ONE) {
+        return (cbm_resolution_t){included_qn, "gsc_include", CONF_IMPORT_MAP, REG_RESOLVED};
+    }
+    if (included_count > SKIP_ONE) {
+        cbm_resolution_t ambiguous = empty_result();
+        ambiguous.strategy = "gsc_ambiguous_include";
+        ambiguous.candidate_count = included_count;
+        return ambiguous;
+    }
+
+    qn_array_t *arr = cbm_ht_get(r->by_name, simple_name(callee_name));
+    if (arr && arr->count == SKIP_ONE) {
+        return (cbm_resolution_t){arr->items[0], "gsc_unique_name", CONF_UNIQUE_NAME,
+                                  REG_RESOLVED};
+    }
+    cbm_resolution_t unresolved = empty_result();
+    unresolved.strategy = arr && arr->count > SKIP_ONE ? "gsc_ambiguous" : "gsc_unresolved";
+    unresolved.candidate_count = arr ? arr->count : 0;
+    return unresolved;
+}
+
 cbm_resolution_t cbm_registry_resolve(const cbm_registry_t *r, const char *callee_name,
                                       const char *module_qn, const char **import_map_keys,
                                       const char **import_map_vals, int import_map_count) {
